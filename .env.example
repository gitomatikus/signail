# Copy this file to .env and adjust values for your environment.
# Docker Compose reads .env automatically for ${VAR} substitution.

# ----- General -----
NODE_ENV=development

# ----- Backend -----
# Port the backend HTTP + WebSocket server listens on (and is published on)
BACKEND_PORT=8000
# Path the WebSocket server is mounted on
WS_PATH=/ws
# Allowed CORS origin(s): "*" for any, or a comma-separated list of origins
# e.g. CORS_ORIGIN=http://localhost:3001,https://game.example.com
CORS_ORIGIN=*

# ----- Frontend -----
# Port the React dev server listens on (and is published on)
FRONTEND_PORT=3001

# Full URL overrides for the API and WebSocket endpoints.
# Leave EMPTY for the recommended default: the frontend builds the URLs from
# the hostname in the browser's address bar + the ports/path below, so the
# app works both via http://localhost:3001 and via your LAN IP.
# Set them only when the backend lives on a different host than the frontend,
# e.g. REACT_APP_API_URL=https://api.example.com
#      REACT_APP_WS_URL=wss://api.example.com/ws
REACT_APP_API_URL=
REACT_APP_WS_URL=

# Used by the frontend to build API/WS URLs when the overrides above are empty
REACT_APP_API_PORT=8000
REACT_APP_WS_PORT=8000
REACT_APP_WS_PATH=/ws
# Hostname fallback when not running in a browser context (rarely needed)
REACT_APP_DEFAULT_HOST=

# Link to the external pack editor shown on the main page
REACT_APP_PACK_EDITOR_URL=https://packer.critfail.art
