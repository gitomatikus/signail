FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

# Runtime config (PORT, WS_PATH, CORS_ORIGIN, NODE_ENV) is supplied via
# docker-compose environment from the root .env file.
ARG BACKEND_PORT=8000
ENV PORT=${BACKEND_PORT}

EXPOSE ${BACKEND_PORT}

CMD ["npm", "run", "dev"]
