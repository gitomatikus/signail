FROM node:18-alpine

WORKDIR /app

COPY package*.json ./

RUN npm install

COPY . .

# API/WS URLs and ports (REACT_APP_*) are supplied via docker-compose
# environment from the root .env file - nothing is hardcoded here.
ARG FRONTEND_PORT=3001
ENV PORT=${FRONTEND_PORT}
ENV HOST=0.0.0.0
ENV WDS_SOCKET_PORT=0
ENV CHOKIDAR_USEPOLLING=false
ENV FAST_REFRESH=false
ENV WATCHPACK_POLLING=false

EXPOSE ${FRONTEND_PORT}

CMD ["npm", "run", "start"]
